# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Public address of this app (used in the links inside emails).
# Locally: http://localhost:3000   In production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (any SMTP provider). Leave empty to fall back to copy-the-link mode.
# Resend example: host smtp.resend.com, port 465, user "resend", pass = your API key.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="LexDesk <no-reply@your-domain.com>"

# Product name shown in the app, emails and landing page
NEXT_PUBLIC_APP_NAME=LexDesk

# --- Scheduled reminders (daily digest of hearings, meetings, deadlines and due tasks) ---
# Any long random string, e.g. run:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# On Vercel, vercel.json already schedules /api/cron/reminders and sends this as the Bearer token.
CRON_SECRET=

# --- Shown on the Terms and Privacy pages (set before launch) ---
NEXT_PUBLIC_COMPANY_NAME=Your Company Name
NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.com
NEXT_PUBLIC_JURISDICTION=Pakistan
